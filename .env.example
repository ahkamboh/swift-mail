# Copy to .env and fill in. Never commit .env.
# On Vercel these are set in Project Settings -> Environment Variables.

# Postgres (Prisma reads POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Gemini (server only, used by /api/gemini)
GEMINI_API_KEY=

# NextAuth + GitHub OAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# MongoDB (only used by src/lib/dbConnect.ts)
MONGODB_URI=
